pipeline {
    agent any

    environment {
        AWS_REGION = "ap-south-1"
        AWS_ACCOUNT_ID = "924263791418"
        ECR_REPO = "${AWS_ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com/epc-frontend"
        IMAGE_TAG = "${BUILD_NUMBER}"

        // Production EC2 Private IP
        FRONTEND_SERVER = "172.31.47.24"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('epc-frontend-main') {
                    sh """
                        docker build -t epc-frontend:${IMAGE_TAG} .
                    """
                }
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${ECR_REPO}
                """
            }
        }

        stage('Tag Docker Image') {
            steps {
                sh """
                    docker tag epc-frontend:${IMAGE_TAG} ${ECR_REPO}:${IMAGE_TAG}
                    docker tag epc-frontend:${IMAGE_TAG} ${ECR_REPO}:latest
                """
            }
        }

        stage('Push Docker Image') {
            steps {
                sh """
                    docker push ${ECR_REPO}:${IMAGE_TAG}
                    docker push ${ECR_REPO}:latest
                """
            }
        }

        stage('Deploy to Production') {
            steps {
                sshagent(credentials: ['frontend-key']) {

                    sh """
                    ssh -o StrictHostKeyChecking=no ubuntu@${FRONTEND_SERVER} <<EOF

                    set -e

                    aws ecr get-login-password --region ${AWS_REGION} | \
                    sudo docker login --username AWS --password-stdin ${ECR_REPO}

                    sudo docker pull ${ECR_REPO}:${IMAGE_TAG}

                    sudo docker stop epc-frontend || true
                    sudo docker rm epc-frontend || true

                    sudo docker run -d \
                        --name epc-frontend \
                        --restart always \
                        -p 80:80 \
                        ${ECR_REPO}:${IMAGE_TAG}

                    sudo docker image prune -f

                    EOF
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Production deployment completed successfully."
        }

        failure {
            echo "Production deployment failed."
        }

        always {
            cleanWs()
        }
    }
}
