pipeline {
    agent any

    environment {
        AWS_REGION = "ap-south-1"
        AWS_ACCOUNT_ID = "924263791418"
        ECR_REPO = "${AWS_ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com/epc-frontend"
        IMAGE_TAG = "${BUILD_NUMBER}"

        // Production EC2 Public IP / Elastic IP
        FRONTEND_SERVER = "43.204.165.63"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('epc-frontend-main') {
                    sh """
                        docker build -t epc-frontend:${IMAGE_TAG} .
                    """
                }
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                """
            }
        }

        stage('Tag Docker Image') {
            steps {
                sh """
                    docker tag epc-frontend:${IMAGE_TAG} ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Push Docker Image') {
            steps {
                sh """
                    docker push ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy to Production') {
            steps {
                sshagent(credentials: ['frontend-key']) {

                    sh """
ssh -o StrictHostKeyChecking=no ubuntu@${FRONTEND_SERVER} <<EOF

aws ecr get-login-password --region ${AWS_REGION} | \
sudo docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

sudo docker pull ${ECR_REPO}:${IMAGE_TAG}

sudo docker stop epc-frontend || true
sudo docker rm epc-frontend || true

sudo docker run -d \
    --name epc-frontend \
    -p 80:80 \
    --restart always \
    ${ECR_REPO}:${IMAGE_TAG}

EOF
"""
                }
            }
        }
    }

    post {

        success {
            echo "Production deployment completed successfully."
        }

        failure {
            echo "Production deployment failed."
        }

        always {
            cleanWs()
        }
    }
}
